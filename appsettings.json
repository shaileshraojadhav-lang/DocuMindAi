{
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://localhost:5050"
      }
    }
  },

  "AzureStorage": {
    "ConnectionString": "",
    "UploadsContainer": "uploads",
    "VideosContainer": "videos"
  },

  "Whisper": {
    "Model": "C:\\whisper\\models\\ggml-base.en.bin",
    "Exe": "C:\\whisper\\whisper-cli.exe"
  },

  "Ollama": {
    "BaseUrl": "http://localhost:11434",
    "Model": "qwen2.5:3b",
    "Options": {
      "temperature": 0.1,
      "top_p": 0.9,
      "repeat_penalty": 1.15,
      "num_predict": 1800,
      "num_ctx": 8192
    }
  },

  "Summary": {
    "Model": "gemma3:1b",
    "MaxChars": 30000,
    "TimeoutMins": 20,
    "Options": {
      "temperature": 0.1,
      "top_p": 0.9,
      "repeat_penalty": 1.15,
      "num_predict": 2200,
      "num_ctx": 8192
    }
  },

  "Embedding": {
    "Model": "nomic-embed-text",
    "Dimensions": 768
  },

  "Qdrant": {
    "Host": "localhost",
    "Port": 6334,
    "Collection": "documind_chunks"
  },

  "VideoIngestor": {
    "WatchFolder": "C:\\videos\\inbox",
    "ProcessedFolder": "C:\\videos\\processed",
    "TempFolder": "C:\\videos\\tmp",
    "FfmpegPath": "C:\\ffmpeg\\bin\\ffmpeg.exe",
    "YtDlpPath": "C:\\tools\\yt-dlp.exe",
    "ChunkMinutes": 2,
    "DeleteTempFiles": true,
    "SupportedExtensions": [
      ".mp4",
      ".mkv",
      ".mov",
      ".avi"
    ]
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "DocuMind": "Debug"
    }
  },

  "AllowedHosts": "*"
}